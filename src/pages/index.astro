<style>
  body {
      margin: 0;
      background: #f7f7f5;
      color: #202020;
      font-family: Arial, "Microsoft YaHei", sans-serif;
      --page-background-image: none;
      background-image: var(--page-background-image);
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
  }

  main {
      max-width: 1120px;
      margin: 0 auto;
      padding: 88px 40px;
   }

  nav {
      max-width: 1120px;
      margin: 0 auto;
      padding: 24px 40px;
      display: flex;
      gap: 32px;
  }

 section {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 20px;
      margin-top: 80px;
  }

  article {
      min-height: 220px;
      padding: 28px;
      border-radius: 24px;
      background: #eceef1;
  }

  h1 {
      margin: 0;
      font-size: 72px;
      letter-spacing: -0.05em;
      line-height: 1.1;
  }

  nav a {
      color: inherit;
      font-weight: 700;
      text-decoration: none;
  }

  nav a:not([aria-current]) {
      color: #777;
      font-weight: 400;
  }

  nav span {
      color: #777;
  }

  footer {
      max-width: 1120px;
      margin: 0 auto;
      padding: 0 40px 48px;
      display: flex;
      justify-content: space-between;
      color: #777;
  }

  footer a {
      color: inherit;
      text-decoration: none;
}
  footer button {
    border: 0;
    padding: 0;
    background: transparent;
    color: inherit;
    font: inherit;
    cursor: pointer;
  }
</style>
<script>
  const button = document.querySelector<HTMLButtonElement>("#change-background");
  const resetButton = document.querySelector<HTMLButtonElement>("#reset-background");
  const fileInput = document.querySelector<HTMLInputElement>("#background-file");
  if (!fileInput) throw new Error("找不到 #background-file 文件输入框");
  let currentUrl: string | undefined;

  function showBackground(image: Blob) {
    if (currentUrl) URL.revokeObjectURL(currentUrl);
    currentUrl = URL.createObjectURL(image);

    document.body.style.setProperty(
      "--page-background-image",
      `url("${currentUrl}")`
    );
  }

  button?.addEventListener("click", () => fileInput?.click());

  const request = indexedDB.open("personal-wiki", 1);

  request.onupgradeneeded = () => {
    request.result.createObjectStore("preferences");
  };

  request.onsuccess = () => {
    const db = request.result;
    const saved = db
      .transaction("preferences", "readonly")
      .objectStore("preferences")
      .get("background");

    saved.onsuccess = () => {
      if (saved.result instanceof Blob) showBackground(saved.result);
    };

    fileInput?.addEventListener("change", () => {
      const image = fileInput.files?.[0];
      if (!image) return;

      showBackground(image);
      db.transaction("preferences", "readwrite")
        .objectStore("preferences")
        .put(image, "background");
    });

    resetButton?.addEventListener("click", () => {
    if (currentUrl) URL.revokeObjectURL(currentUrl);
    currentUrl = undefined;
    document.body.style.removeProperty("--page-background-image");
    fileInput.value = "";

    db.transaction("preferences", "readwrite")
      .objectStore("preferences")
      .delete("background");
  });
};
</script>
